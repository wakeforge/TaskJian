{
  "name": "@taskjian/main",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --external:electron --watch",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --external:electron --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@taskjian/shared": "workspace:*"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
